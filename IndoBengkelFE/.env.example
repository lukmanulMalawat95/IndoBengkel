# Frontend
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_GEOCODER_URL=

# false = talk to the NestJS API through the Next.js proxy below.
# true  = run the standalone localStorage demo with no backend.
NEXT_PUBLIC_USE_MOCK_API=false

# Server-side proxy target used by next.config.ts.
# Local dev: http://localhost:4000 · Docker Compose: http://backend:4000
API_INTERNAL_URL=http://localhost:4000
