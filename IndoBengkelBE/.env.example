DATABASE_URL="postgresql://indobengkel:indobengkel@localhost:55432/indobengkel?schema=public"
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Set to true when the app is served over HTTPS (enables Secure cookies + HSTS).
COOKIE_SECURE=false
# Set to true when a reverse proxy terminates TLS and forwards X-Forwarded-For.
TRUST_PROXY=false
# Optional. When set, rate-limit counters are shared across API instances.
# The Docker stack defaults to redis://redis:6379/0; local tests can use
# redis://localhost:6379/0 when the compose `redis` service is running.
# Empty = per-process memory (with automatic fallback if Redis is unreachable).
REDIS_URL=
# Production controls. Leave enabled outside tests.
CSRF_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL=1200
